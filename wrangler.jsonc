{
  // Cloudflare Worker for greenkurdistan.dev: worker/index.js serves /api/*, ./dist holds the website. Deploy with: npm run deploy
  "name": "green-kurdistan",
  "main": "worker/index.js",
  "account_id": "8ea94398eefe47ca34fc47e9d1c48184",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "greenkurdistan.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_id": "7cdfd907-fac0-4c91-8343-b06a0388d3f6" }],
  "vars": { "ALLOWED_ORIGINS": "" },
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": false, "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 } }
}
